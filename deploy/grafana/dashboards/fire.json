  {
   "id": 7,
   "type": "table",
   "title": "Application health (heartbeats)",
   "description": "One row per process. DOWN means no heartbeat for 15 s.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "fire-ts"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "fire-ts"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT process AS \"component\", round(extract(epoch FROM now() - last_seen)::numeric, 1) AS \"seconds since last heartbeat\", CASE WHEN now() - last_seen < interval '15 seconds' THEN 'UP' ELSE 'DOWN' END AS status, sim_time AS \"sim time\" FROM component_status ORDER BY process",
     "refId": "A"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "state-timeline",
   "title": "Room state over time (from the detector's decisions)",
   "description": "Green idle, yellow armed or warning, red fire. Decisions and periodic refreshes both drive this.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "fire-ts"
   },
   "gridPos": {
    "x": 8,
