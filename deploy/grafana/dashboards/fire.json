   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "fire-ts"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT wall_ts AS time, room AS metric, CASE state WHEN 'fire' THEN 2 WHEN 'warning' THEN 1 WHEN 'cancelled' THEN 1 ELSE 0 END AS value FROM decisions WHERE $__timeFilter(wall_ts) ORDER BY 1",
     "refId": "A"
    }
   ],
   "options": {
